{
  "Prognode": {
    "ProductName": "PROGNODE",
    "LocalPort": 5080,
    "ProductStage": "Release Candidate",
    "DiscoveryPort": 5081,
    "LanClientApiEnabled": true,
    "LanHttps": {
      "Enabled": false,
      "Port": 5443,
      "PfxPath": "",
      "Thumbprint": "",
      "PasswordEnvironmentVariable": "PROGNODE_LAN_PFX_PASSWORD"
    },
    "ServerName": "",
    "RemoteAccess": {
      "BaseUrl": "",
      "StatusPath": "/api/v1/remote-access/status",
      "BindServerPath": "/api/v1/remote-access/bind-server",
      "RegisterClientPath": "/api/v1/remote-access/register-client",
      "PushTokenPath": "/api/v1/remote-access/push-token",
      "RevokeClientPath": "/api/v1/remote-access/revoke-client",
      "PublishNotificationPath": "/api/v1/remote-access/notifications",
      "CommandsPath": "/api/v1/remote-access/commands",
      "CompleteCommandPath": "/api/v1/remote-access/commands/complete",
      "SyncIntervalSeconds": 300
    },
    "CloudLicense": {
      "BaseUrl": "https://prognode.io",
      "ActivatePath": "/api/core/activate",
      "HeartbeatPath": "/api/core/heartbeat",
      "HeartbeatIntervalSeconds": 60,
      "FallbackBaseUrls": [
        "https://account.prognode.io",
        "https://control.prognode.io"
      ]
    },
    "Backup": {
      "DailyHourLocal": 2,
      "RetentionDays": 30
    }
  }
}
