{
  "targets": [
    {
      "name": "Line 1 S7-1500",
      "protocol": "Siemens S7",
      "host": "192.168.0.10",
      "port": 102,
      "pollMs": 1000,
      "tags": [
        {
          "name": "Motor speed",
          "address": "DB10.DBD0",
          "type": "Float32"
        },
        {
          "name": "Running",
          "address": "DB10.DBX4.0",
          "type": "Bool"
        },
        {
          "name": "Test constant",
          "address": "DB10.DBW6",
          "type": "Word",
          "expect": 1234
        },
        {
          "name": "Emergency stop input",
          "address": "%I0.0",
          "type": "Bool"
        },
        {
          "name": "Analog input",
          "address": "%IW64",
          "type": "Int16"
        },
        {
          "name": "Motor output",
          "address": "%Q0.1",
          "type": "Bool"
        },
        {
          "name": "Setpoint (merker)",
          "address": "%MD20",
          "type": "Float32"
        }
      ]
    },
    {
      "name": "Energy meter Modbus",
      "protocol": "Modbus TCP",
      "host": "192.168.0.20",
      "port": 502,
      "unitId": 1,
      "pollMs": 1000,
      "tags": [
        {
          "name": "Pressure",
          "address": "40001",
          "type": "Float32",
          "byteOrder": "CDAB"
        },
        {
          "name": "Level x100",
          "address": "40003",
          "type": "Int16",
          "decimals": 2
        },
        {
          "name": "Active energy (64-bit)",
          "address": "419000",
          "type": "Float64"
        },
        {
          "name": "Energy counter",
          "address": "419004",
          "type": "UInt64",
          "byteOrder": "CDAB"
        }
      ]
    },
